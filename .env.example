# Postgres connection (runtime). DATABASE_URL is accepted as a fallback.
NUXT_DATABASE_URL=postgresql://postgres:fleetdev@127.0.0.1:55432/gather

# Public base URL used for share links, .ics files and Open Graph tags (runtime).
# Leave empty to use the request's own origin.
NUXT_PUBLIC_SITE_URL=http://localhost:5109

# Max RSVP submissions per IP per 10 minutes (runtime, optional).
# NUXT_RSVP_RATE_LIMIT=10

# Port and host for `npm start` (runtime). Nitro also reads NITRO_PORT / NITRO_HOST.
# PORT=3000
# HOST=0.0.0.0
